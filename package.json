{
  "name": "jc-opensearch-client",
  "version": "1.0.0",
  "description": "JAIRO Cloud OpenSearch クライアント",
  "main": "src/main.js",
  "author": "Takanori Hayashi",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "jp.ac.nii.jc-opensearch-client",
    "productName": "JAIRO Cloud OpenSearch クライアント",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
